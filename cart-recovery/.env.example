# Copy to .env.local for local runs. In production, set these in Vercel and in the worker host.
SHOPIFY_STORE=eacjyd-yz.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_API_SECRET=            # app API secret key, used to verify webhook HMAC
SHOPIFY_ADMIN_TOKEN=           # shpat_... Admin API access token
MANYCHAT_API_KEY=              # ManyChat -> Settings -> API
MANYCHAT_URL_FIELD_ID=         # numeric id of custom field recovery_url
MANYCHAT_CODE_FIELD_ID=        # numeric id of custom field discount_code
MANYCHAT_FLOW_NS=              # flow namespace, e.g. content20261004123456_123456
REDIS_URL=redis://...
RECOVERY_DELAY_MINUTES=30
APP_URL=https://YOUR-PROJECT.vercel.app
